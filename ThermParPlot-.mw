<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# TauTimp -- Thermal Particle Wave Equation &amp; Probability PDE
# Maple transcript (paired with TauTimp_ThermalParticle.md)
# Author: Viorel
# ============================================================

restart;
with(plots):
with(plottools):
interface(displayprecision = 10):

# ------------------------------------------------------------
# SECTION 1. Physical constants and parameters
# ------------------------------------------------------------
hbar  := 1.054571817e-34:        # J*s
me    := 9.1093837e-31:          # kg
eV    := 1.602176634e-19:        # J
c0    := 2.99792458e8:           # m/s
R     := 4.235518529e22:              # m  (TauTimp cosmological radius)
lqn   := 1/2:                    # spin magnetic moment quantum number
llp1  := lqn*(lqn+1);            # l(l+1) = 3/4

<Font encoding="UTF-8">printf(&quot;R          = %.6e m\134n&quot;,   evalf(R)):
printf(&quot;m_e        = %.6e kg\134n&quot;,  evalf(me)):
printf(&quot;hbar       = %.6e J*s\134n&quot;, evalf(hbar)):
printf(&quot;l(l+1)     = %.6f\134n&quot;,     evalf(llp1)):
</Font>
# ------------------------------------------------------------
# SECTION 2. The governing PDE (symbolic)
# ------------------------------------------------------------
# (2m/hbar^2)(E - l(l+1) hbar^2/(2 m r^2)) f + (R/r^2) d^2(r f)/dr^2
#                                         = (1/V^2) d^2 f/dt^2
PDE_full := (2*m/hbar^2)*(E - lqn*(lqn+1)*hbar^2/(2*m*r^2))*F(r,t)
          + (R/r^2)*diff(r*F(r,t), r$2)
          - (1/V^2)*diff(F(r,t), t$2) = 0;

print(&quot;Full TauTimp thermal-particle PDE:&quot;):
print(PDE_full):

# ------------------------------------------------------------
# SECTION 3. Separation of variables F(r,t) = g(r) * exp(-I omega t)
# ------------------------------------------------------------
# Substitute h(r) = r * g(r) and use d^2(r g)/dr^2 = 2 g' + r g''
# Result: R h''(r) + ( 2 m E/hbar^2 + omega^2/V^2 - l(l+1)/r^2 ) h(r) = 0

ODE_h := R*diff(H(r), r$2)
       + ( 2*m*Ev/hbar^2 + omega^2/V^2 - lqn*(lqn+1)/r^2 )*H(r) = 0;

print(&quot;Reduced radial ODE (h(r) = r*g(r)):&quot;):
print(ODE_h):

# Because l(l+1)/R is cosmologically tiny, the equation reduces to
#   h''(r) + kappa^2 h(r) = 0 ,  with kappa^2 = K/R ,
# K := 2 m E/hbar^2 + omega^2/V^2

kappa := 'kappa':
H_sol := A*sin(kappa*r) + B*cos(kappa*r);
print(&quot;Reduced free-radial solution:&quot;):
print( H(r) = H_sol ):

# Regularity at r=0 of g(r)=h(r)/r forces B=0
g_sol := A*sin(kappa*r)/r;
print(&quot;Radial eigenfunction g(r):&quot;):
print( g(r) = g_sol ):

# ------------------------------------------------------------
# SECTION 4. Quantization from f(R,t) = 0
# ------------------------------------------------------------
# sin(kappa_n R) = 0  =&gt;  kappa_n = n*Pi/R
# Energy:  E_n = hbar^2 n^2 Pi^2 / (2 m R)

E_of_n := unapply( hbar^2 * n^2 * Pi^2 / (2 * me * R), n ):

<Font encoding="UTF-8">printf(&quot;\134n--- Energy spectrum E_n (TauTimp thermal modes) ---\134n&quot;):
</Font>for k from 1 to 6 do
  En_J  := evalf( E_of_n(k) ):
  En_eV := evalf( En_J / eV ):
<Font encoding="UTF-8">  printf(&quot;n=%d :  E_n = %.6e J  =  %.6e eV\134n&quot;, k, En_J, En_eV):
</Font>end do:

# Quantization wavevector and wavelength
<Font encoding="UTF-8">printf(&quot;\134n--- kappa_n and wavelength lambda_n = 2*Pi/kappa_n ---\134n&quot;):
</Font>for k from 1 to 6 do
  kn  := evalf( k*Pi/R ):
  lan := evalf( 2*Pi/kn ):
<Font encoding="UTF-8">  printf(&quot;n=%d :  kappa_n = %.6e 1/m   lambda_n = %.6e m\134n&quot;, k, kn, lan):
</Font>end do:

# ------------------------------------------------------------
# SECTION 5. Radial eigenfunction plot
# ------------------------------------------------------------
# Plot g_n(r) = sin(n*Pi*r/R)/r on r in [R/1000, R] for n = 1,2,3
# Use dimensionless x = r/R for clarity; g shown in units of 1/R.

g_dimless := (nn, x) -&gt; sin(nn*Pi*x)/x:    # actually sin(n*Pi*r/R)/(r) * R --&gt; shown vs x=r/R

plot_radial := plot(
  [g_dimless(1, x), g_dimless(2, x), g_dimless(3, x)],
  x = 0.01 .. 1,
  color  = [red, blue, &quot;DarkGreen&quot;],
  thickness = 2,
  labels = [&quot;r / R&quot;, &quot;g_n(r) * R&quot;],
  title  = &quot;TauTimp thermal radial eigenfunctions n=1,2,3&quot;,
  legend = [&quot;n = 1&quot;, &quot;n = 2&quot;, &quot;n = 3&quot;]
):

# ------------------------------------------------------------
# SECTION 6. Probability-density PDE and Gaussian envelope
# ------------------------------------------------------------
# Equation:  d^2 P/dt^2 - d^2 (P V^2)/dr^2 = V^2 P / R
# For V = const = Vbar:
#   d^2 P/dt^2 - Vbar^2 d^2 P/dr^2 = Vbar^2 P / R

PDE_P := diff(P(r,t), t$2) - Vb^2*diff(P(r,t), r$2) = Vb^2*P(r,t)/R;
print(&quot;Probability-density PDE (constant V):&quot;):
print(PDE_P):

# Gaussian ansatz: P(r,t) = N(t) * exp( -(r-r0)^2 / (2 sigma(t)^2) )
P_ansatz := N(t) * exp( -(r-r0)^2 / (2*sigma(t)^2) );
print(&quot;Gaussian ansatz:&quot;):
print( P(r,t) = P_ansatz ):

# Match coefficients =&gt; ODE system:
#   (r-r0)^4 :  d/dt sigma = +/- Vbar
#   (r-r0)^2 :  d/dt log(N) = 2 Vbar / sigma
#   (r-r0)^0 :  d^2/dt^2(N)/N + Vbar^2/sigma^2 = Vbar^2 / R

# General solution with sigma(0)=sigma0, N(0)=N0:
sigma_t := (sigma0, Vb, t) -&gt; sigma0 + Vb*t:
N_t     := (N0, sigma0, Vb, t) -&gt; N0*( 1 + Vb*t/sigma0 )^2:

# Consistency at the validity point: 3 Vbar^2/sigma^2 = Vbar^2/R
#   =&gt;  sigma0 = sqrt(3 R)
sigma0_validity := sqrt(3*R):
<Font encoding="UTF-8">printf(&quot;\134n--- Envelope consistency point ---\134n&quot;):
printf(&quot;sigma0_validity = sqrt(3R) = %.6e m\134n&quot;, evalf(sigma0_validity)):
printf(&quot;    (i.e. the natural cosmological width that closes the ODE)\134n&quot;):
</Font>
# Check boundary condition P(2R, 0) = 0 in the asymptotic sense
# (Gaussian is never identically zero; we report the suppression)
suppression := evalf( exp( -(2*R)^2/(2*(sigma0_validity)^2) ) ):
<Font encoding="UTF-8">printf(&quot;\134n--- Boundary condition P(2R,0) ~ exp(-2R/3) ---\134n&quot;):
printf(&quot;Suppression factor exp(-(2R)^2/(2 sigma0^2)) = exp(-2R/3) = %.6e\134n&quot;,
</Font>        suppression):
<Font encoding="UTF-8">printf(&quot;    =&gt; effectively zero on any physical scale\134n&quot;):
</Font>
# ------------------------------------------------------------
# SECTION 7. Numerical envelope evolution -- normalized units
# ------------------------------------------------------------
# To plot in finite range, normalize: tau = Vb*t/sigma0,  xi = (r-r0)/sigma0
# Then  P/N0 = (1+tau)^2 * exp( -xi^2 / (2 (1+tau)^2) )
# This shows the Gaussian envelope spreading linearly in tau.

P_norm := (xi, tau) -&gt; (1+tau)^2 * exp( -xi^2 / (2*(1+tau)^2) ):

# Snapshot plots at tau = 0, 0.5, 1.0, 2.0
plot_envelope := plot(
  [ P_norm(xi, 0), P_norm(xi, 0.5), P_norm(xi, 1.0), P_norm(xi, 2.0) ],
  xi = -8 .. 8,
  color  = [red, &quot;Orange&quot;, blue, &quot;DarkGreen&quot;],
  thickness = 2,
  labels = [&quot;xi = (r-r0)/sigma0&quot;, &quot;P / N0&quot;],
  title  = &quot;Gaussian envelope evolution -- TauTimp probability density&quot;,
  legend = [&quot;tau = 0&quot;, &quot;tau = 0.5&quot;, &quot;tau = 1.0&quot;, &quot;tau = 2.0&quot;]
):

# ------------------------------------------------------------
# SECTION 8. 3D surface  P_norm(xi, tau)
# ------------------------------------------------------------
plot_surface := plot3d(
  P_norm(xi, tau),
  xi  = -6 .. 6,
  tau =  0 .. 2,
  axes = boxed,
  labels = [&quot;xi&quot;, &quot;tau&quot;, &quot;P / N0&quot;],
  title  = &quot;Probability density P/N0 vs. (xi, tau)&quot;,
  colorscheme = [&quot;zgradient&quot;, [&quot;MidnightBlue&quot;, &quot;Cyan&quot;, &quot;Yellow&quot;, &quot;OrangeRed&quot;]],
  style = surface,
  grid = [60, 40]
):

# ------------------------------------------------------------
# SECTION 9. Energy-spectrum bar chart
# ------------------------------------------------------------
En_list := [ seq( [k, evalf( E_of_n(k)/eV ) ], k = 1 .. 8 ) ]:
plot_energy := plot(
  En_list,
  style = pointline,
  symbol = solidcircle,
  symbolsize = 16,
  color = &quot;DarkRed&quot;,
  thickness = 2,
  labels = [&quot;n&quot;, &quot;E_n  [eV]&quot;],
  title  = &quot;Thermal-particle eigenenergies E_n = hbar^2 n^2 Pi^2/(2 m R)&quot;
):

# ------------------------------------------------------------
# SECTION 10. Combined panel
# ------------------------------------------------------------
display( Array( [ plot_radial, plot_envelope, plot_energy, plot_surface ] ) );

# ------------------------------------------------------------
# SECTION 11. Final diagnostics
# ------------------------------------------------------------
<Font encoding="UTF-8">printf(&quot;\134n=================  SUMMARY  =================\134n&quot;):
printf(&quot;Quantization:        kappa_n = n*Pi/R\134n&quot;):
printf(&quot;Eigenenergies:       E_n = hbar^2 n^2 Pi^2 / (2 m R)\134n&quot;):
printf(&quot;  E_1 = %.6e eV\134n&quot;, evalf( E_of_n(1)/eV ) ):
printf(&quot;  E_2 = %.6e eV\134n&quot;, evalf( E_of_n(2)/eV ) ):
printf(&quot;  E_3 = %.6e eV\134n&quot;, evalf( E_of_n(3)/eV ) ):
printf(&quot;Envelope width:      sigma(t) = sigma0 + Vbar*t,  sigma0 = sqrt(3R)\134n&quot;):
printf(&quot;Envelope amplitude:  N(t) = N0 (1 + Vbar*t/sigma0)^2\134n&quot;):
printf(&quot;Boundary:            P(2R,0) ~ exp(-2R/3) = %.3e  (=&gt; 0)\134n&quot;, suppression):
printf(&quot;=============================================\134n&quot;):
</Font></Text-field>
