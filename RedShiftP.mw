<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ===========================================================================
<Font encoding="UTF-8"># TauTimp \342\200\224 Redshift from Spatial Flux Growth Rate
# Onduscular Theory (Teoria Ondusculara) \342\200\224 Author: Viorel-Mihai Popescu
# Maple Transcript \342\200\224 Version: May 2026
</Font># ===========================================================================

restart;
with(plots):
with(PDEtools):
with(DEtools):

# ---------------------------------------------------------------------------
# SECTION 0: Physical Parameters
# ---------------------------------------------------------------------------

# Fundamental constants
c_SI := 2.99792458e8:          # m/s, speed of light
H0_SI := 67.41e3 / 3.085678e22: # s^-1, Hubble constant (Planck 2018)
H0_kms := 67.41:               # km/s/Mpc

# Onduscular cosmological radii (SI, metres)
Rs_SI := 8.3855194e25:         # m  (= 8.86369 Gly)
R_SI  := 4.235518529e22:            # m  (= 4.477 million LY)

# Conversion factor
Gly_to_m := 9.4607304725808e24: # 1 Gly = 9.461e24 m

# Onduscular radii in Gly
Rs_Gly := Rs_SI / Gly_to_m:
print(&quot;Rs (Gly) =&quot;, evalf(Rs_Gly, 6));
# =&gt; 8.86369 Gly

TwoRs_Gly := 2 * Rs_Gly:
print(&quot;2Rs (Gly) =&quot;, evalf(TwoRs_Gly, 6));
# =&gt; 17.7274 Gly

# Boundary parameters
<Font encoding="UTF-8">r_min_flux := 0.290:   # Gly \342\200\224 inner boundary for muon flux normalization
r_min_cosm := 0.431:   # Gly \342\200\224 epoch of first star formation
</Font>
# Hubble horizon
RH_Gly := c_SI / (H0_SI * Gly_to_m):
print(&quot;Hubble horizon R_H (Gly) =&quot;, evalf(RH_Gly, 6));
# =&gt; 14.505 Gly

# ---------------------------------------------------------------------------
# SECTION 1: Onduscular Wave Equation and Separation of Variables
# ---------------------------------------------------------------------------
# Governing equation (spherical symmetry):
#   (Rs/r) * (f_rr + 2/r * f_r) = (1/c^2) * f_tt
#
# Separating f(r,t) = g(r)*u(t):
#   Time ODE:  u'' + lambda^2 * c^2 * u = 0
#   Radial ODE: g'' + (2/r)*g' + (lambda^2 * r / Rs) * g = 0

# Display the radial ODE symbolically
r_var := 'r': Rs_sym := 'Rs': lam := 'lambda_n':
radialODE := diff(g(r_var), r_var, r_var)
            + (2/r_var) * diff(g(r_var), r_var)
            + (lam^2 * r_var / Rs_sym) * g(r_var) = 0:
print(&quot;Radial ODE:&quot;, radialODE);

# Substitution g(r) = r^(-1/2) * phi(r) reduces to the Airy equation:
#   d^2 phi / d xi^2 = xi * phi,   xi = (lambda^2 / Rs)^(1/3) * r
print(&quot;Airy equation: d^2 phi/d xi^2 = xi * phi&quot;);
print(&quot;Airy zeros a_1 = -2.3381, a_2 = -4.0879, a_3 = -5.5206&quot;);

# Eigenvalue quantization from boundary condition Ai(alpha_n * 2*Rs) = 0:
airy_zeros := [-2.3381, -4.0879, -5.5206]:
lambda_n := proc(n)
  local an;
  an := airy_zeros[n];
  return (-an)^(3/2) / (2 * sqrt(Rs_SI));
end proc:

for n from 1 to 3 do
  print(sprintf(&quot;lambda_%d = %.6e s^-1 m^-1&quot;, n, lambda_n(n)));
  print(sprintf(&quot;omega_%d  = %.6e rad/s&quot;, n, lambda_n(n) * c_SI));
end do:

# ---------------------------------------------------------------------------
<Font encoding="UTF-8"># SECTION 2: Muon Neutrino Flux P(r,0) \342\200\224 Polynomial Solution
</Font># ---------------------------------------------------------------------------

# Define symbolic variables (Gly units)
r := 'r':
Rs := Rs_Gly:
r0 := r_min_flux:   # 0.290 Gly (inner boundary, flux normalization)

# Factored form (satisfies boundary conditions)
P0 := C_norm * (r - r0) * (2*Rs - r):
print(&quot;P(r,0) =&quot;, P0);

# Compute analytic integral G
integrand_G := (r - r0) * (2*Rs - r) / r^2:
G_analytic := (r0 + 2*Rs) * ln(2*Rs / r0) - 2*(2*Rs - r0):
G_val := evalf(G_analytic * Gly_to_m, 7):
print(&quot;G (SI, m) =&quot;, G_val);
# Expected: 3.3285e26 m

# Determine normalization constant C from integral F(r) dr = c/H0
RH_SI := c_SI / H0_SI:
print(&quot;Hubble horizon R_H (SI, m) =&quot;, evalf(RH_SI, 6));

C_val := 4 * Pi * c_SI / (H0_SI * G_val):
print(&quot;C =&quot;, evalf(C_val, 6), &quot;m^-2&quot;);
# Expected: 5.1809 m^-2

# Polynomial coefficients of P(r,0) = C*(r-r0)*(2Rs-r) = -C*r^2 + C*(r0+2Rs)*r - C*r0*2Rs
# (in Gly units for r, C in m^-2, values in Gly^2 * m^-2 = dimensionless ratio)
p2 := -C_val:
p1 := C_val * (r_min_flux + 2*Rs_Gly):
p0 := -C_val * r_min_flux * 2*Rs_Gly:
print(&quot;p2 =&quot;, evalf(p2, 5));
print(&quot;p1 =&quot;, evalf(p1, 5), &quot;Gly^-1&quot;);
print(&quot;p0 =&quot;, evalf(p0, 5), &quot;Gly^-2&quot;);

# ---------------------------------------------------------------------------
# SECTION 3: Spatial Flux Growth Rate Lambda(r)
# ---------------------------------------------------------------------------

# Lambda(r) is the spatial flux per unit surface, integrated to give comoving distance.
# From the PDE solution at t=0, expanded as Laurent series in r (Gly units):
#
#   Lambda(r) = A2/r^2 + A1/r + A0
#
# Coefficients (Rs = 8.2, c = 3, normalized units):
A2 := 43.1072:
A1 := -0.6533:
A0 := -0.12012:

Lambda := r -&gt; A2/r^2 + A1/r + A0:
print(&quot;Lambda(r) =&quot;, A2, &quot;/r^2 +&quot;, A1, &quot;/r +&quot;, A0);

# Indefinite integral (antiderivative)
Lambda_int := r -&gt; -A2/r + A1*ln(r) + A0*r:
print(&quot;Integral of Lambda(r) dr = -43.10796/r +&quot;, A1, &quot;*ln(r) +&quot;, A0, &quot;*r + const&quot;);

# Verify: integral from r_min_cosm to 2*Rs gives 93 Gly
cosm_integral := Lambda_int(2*Rs_Gly) - Lambda_int(r_min_cosm):
print(&quot;Integral from 0.431 to 17.727 Gly =&quot;, evalf(cosm_integral, 5), &quot;Gly&quot;);
# Expected: ~93 Gly

# ---------------------------------------------------------------------------
# SECTION 4: Hubble Constant Derivation from Onduscular Parameters
# ---------------------------------------------------------------------------

# H0 derived analytically:
#   H0 = 4*pi*c / (C * G)
H0_derived := 4 * Pi * c_SI / (C_val * G_val):
H0_derived_kms := H0_derived * 3.085678e22 / 1e3:
print(&quot;H0 (derived) =&quot;, evalf(H0_derived_kms, 5), &quot;km/s/Mpc&quot;);
# Expected: 67.41 km/s/Mpc

# ---------------------------------------------------------------------------
<Font encoding="UTF-8"># SECTION 5: PDE Solution \342\200\224 Full Time Dependence
</Font># ---------------------------------------------------------------------------

# P(r,t) via d'Alembert:
#   P(r,t) = C * [(r - r_min)(2Rs - r) - c^2 * t^2]
# In Gly/Gyr units: c = 1 Gly/Gyr

c_Gly := 1.0:   # Gly/Gyr (speed of light in natural cosmological units)

P_rt := (r_val, t_val) -&gt; C_val * ((r_val - r_min_flux) * (2*Rs_Gly - r_val) - c_Gly^2 * t_val^2):
print(&quot;P(r,t) = C * [(r - r_min)(2Rs - r) - c^2 * t^2]&quot;);
print(&quot;P(r,0) check at r=8 Gly:&quot;, evalf(P_rt(8.0, 0), 5));
print(&quot;P(2Rs,0) check (BC):&quot;,     evalf(P_rt(2*Rs_Gly, 0), 5));

# ---------------------------------------------------------------------------
<Font encoding="UTF-8"># SECTION 6: PLOT 1 \342\200\224 P(r,0) Muon Neutrino Flux Profile
</Font># ---------------------------------------------------------------------------

P0_plot := r -&gt; (r - r_min_flux) * (2*Rs_Gly - r):  # unnormalized shape

plot1 := plot(P0_plot(r), r = r_min_flux .. 2*Rs_Gly,
  color = &quot;Blue&quot;,
  thickness = 2,
<Font encoding="UTF-8">  title = &quot;Figure 1: Muon Neutrino Flux P(r,0) \342\200\224 Bell Profile&quot;,
</Font>  labels = [&quot;r  [Gly]&quot;, &quot;P(r,0)  [normalized, Gly^2]&quot;],
  labelfont = [TIMES, BOLD, 11],
  titlefont = [TIMES, BOLD, 12],
  gridlines = true,
  axes = BOXED
):
print(plot1);

# ---------------------------------------------------------------------------
<Font encoding="UTF-8"># SECTION 7: PLOT 2 \342\200\224 Spatial Flux Growth Rate Lambda(r)
</Font># ---------------------------------------------------------------------------

plot2 := plot(Lambda(r), r = r_min_cosm .. 2*Rs_Gly,
  color = &quot;Red&quot;,
  thickness = 2,
<Font encoding="UTF-8">  title = &quot;Figure 2: Spatial Flux Growth Rate Lambda(r) \342\200\224 TauTimp Redshift&quot;,
</Font>  labels = [&quot;r  [Gly]&quot;, &quot;Lambda(r)  [Gly^-1]&quot;],
  labelfont = [TIMES, BOLD, 11],
  titlefont = [TIMES, BOLD, 12],
  gridlines = true,
  axes = BOXED,
  view = [r_min_cosm .. 2*Rs_Gly, -1 .. 10]
):
print(plot2);

# ---------------------------------------------------------------------------
<Font encoding="UTF-8"># SECTION 8: PLOT 3 \342\200\224 Cumulative Comoving Distance Integral
</Font># ---------------------------------------------------------------------------

Cumulative := r -&gt; Lambda_int(r) - Lambda_int(r_min_cosm):

plot3 := plot(Cumulative(r), r = r_min_cosm .. 2*Rs_Gly,
  color = &quot;DarkGreen&quot;,
  thickness = 2,
  title = &quot;Figure 3: Cumulative Comoving Distance = Integral of Lambda(r)&quot;,
  labels = [&quot;r  [Gly]&quot;, &quot;Cumulative integral  [Gly]&quot;],
  labelfont = [TIMES, BOLD, 11],
  titlefont = [TIMES, BOLD, 12],
  gridlines = true,
  axes = BOXED
):
print(plot3);

# ---------------------------------------------------------------------------
<Font encoding="UTF-8"># SECTION 9: PLOT 4 \342\200\224 Flux Density at Surface F(r) = P(r,0)/(4*pi*r^2)
</Font># ---------------------------------------------------------------------------

F_r := r -&gt; C_val * (r - r_min_flux) * (2*Rs_Gly - r) / (4 * Pi * r^2):

plot4 := plot(F_r(r), r = r_min_flux .. 2*Rs_Gly,
  color = &quot;Purple&quot;,
  thickness = 2,
  title = &quot;Figure 4: Onduscular Surface Flux Density F(r) = P(r,0)/(4pi r^2)&quot;,
  labels = [&quot;r  [Gly]&quot;, &quot;F(r)  [Gly^-3]&quot;],
  labelfont = [TIMES, BOLD, 11],
  titlefont = [TIMES, BOLD, 12],
  gridlines = true,
  axes = BOXED
):
print(plot4);

# ---------------------------------------------------------------------------
<Font encoding="UTF-8"># SECTION 10: PLOT 5 \342\200\224 Lambda(r): Comparison with Hubble Law
</Font># ---------------------------------------------------------------------------

# Hubble law in natural units: v(r) = H0 * r
# In Gly units: H0 ~ 0.0689 Gyr^-1 ~ constant slope
H0_nat := H0_kms / (3.085678e22 / 1e3 / (3.15576e16)):  # Gyr^-1
print(&quot;H0 (Gyr^-1) =&quot;, evalf(H0_nat, 4));

Hubble_line := r -&gt; H0_nat * r:

plot5 := plot([Lambda(r), Hubble_line(r)], r = 0.5 .. 2*Rs_Gly,
  color = [&quot;Red&quot;, &quot;Navy&quot;],
  thickness = [2, 2],
  linestyle = [SOLID, DASH],
  title = &quot;Figure 5: Lambda(r) vs Linear Hubble Law&quot;,
  labels = [&quot;r  [Gly]&quot;, &quot;Growth rate  [Gyr^-1]&quot;],
  labelfont = [TIMES, BOLD, 11],
  titlefont = [TIMES, BOLD, 12],
  legend = [&quot;TauTimp Lambda(r)&quot;, &quot;Hubble H0*r&quot;],
  legendstyle = [location = right],
  gridlines = true,
  axes = BOXED,
  view = [0.5 .. 2*Rs_Gly, -0.1 .. 1.0]
):
print(plot5);

# ---------------------------------------------------------------------------
<Font encoding="UTF-8"># SECTION 11: PLOT 6 \342\200\224 P(r,t) Time Evolution (3D Surface)
</Font># ---------------------------------------------------------------------------

P_shape := (r_val, t_val) -&gt; max(0, (r_val - r_min_flux) * (2*Rs_Gly - r_val) - t_val^2):

plot6 := plot3d(P_shape(r, t), r = r_min_flux .. 2*Rs_Gly, t = 0 .. 10,
  axes = BOXED,
  labels = [&quot;r [Gly]&quot;, &quot;t [Gyr]&quot;, &quot;P(r,t) [norm.]&quot;],
  title = &quot;Figure 6: Time Evolution of Muon Neutrino Flux P(r,t)&quot;,
  titlefont = [TIMES, BOLD, 12],
  style = surface,
  shading = ZHUE,
  orientation = [45, 65],
  grid = [40, 30]
):
print(plot6);

# ---------------------------------------------------------------------------
<Font encoding="UTF-8"># SECTION 12: PLOT 7 \342\200\224 Redshift z(r) from TauTimp vs Hubble
</Font># ---------------------------------------------------------------------------

# TauTimp redshift proxy: z(r) proportional to cumulative Lambda integral.
# Cumulative(2*Rs_Gly) ~ 93 Gly; we map this to observed z_max ~ 15 (GN-z11 scale).
# Normalization factor = z_max / integral_total = 15 / 93 ~ 0.1613  [Gly^-1].
# This is dimensionally correct: [z] = dimensionless, [integral] = Gly.
z_max_ref     := 15.0:
integral_tot  := evalf(Cumulative(2*Rs_Gly), 6):
z_norm_factor := z_max_ref / integral_tot:
<Font encoding="UTF-8">printf(&quot;Integral_tot (Gly)     = %.4f\134n&quot;, integral_tot);
printf(&quot;z_norm_factor (Gly^-1) = %.6f   [= z_max / integral_tot]\134n&quot;, z_norm_factor);
</Font>
z_TauTimp := r -&gt; z_norm_factor * Cumulative(r):

# Standard Hubble redshift linear approximation (z = H0*r/c, c = 1 Gly/Gyr)
z_Hubble := r -&gt; H0_nat * r:

plot7 := plot([z_TauTimp(r), z_Hubble(r)], r = 0.5 .. 2*Rs_Gly,
  color = [&quot;OrangeRed&quot;, &quot;SteelBlue&quot;],
  thickness = [2, 2],
  linestyle = [SOLID, DASH],
<Font encoding="UTF-8">  title = &quot;Figure 7: Redshift z(r) \342\200\224 TauTimp vs Linear Hubble&quot;,
</Font>  labels = [&quot;r  [Gly]&quot;, &quot;Redshift  z&quot;],
  labelfont = [TIMES, BOLD, 11],
  titlefont = [TIMES, BOLD, 12],
  legend = [&quot;TauTimp z(r)&quot;, &quot;Hubble linear z(r)&quot;],
  legendstyle = [location = top],
  gridlines = true,
  axes = BOXED
):
print(plot7);

# ---------------------------------------------------------------------------
# SECTION 13: Numerical Summary
# ---------------------------------------------------------------------------

print(&quot;=============================================================&quot;);
<Font encoding="UTF-8">print(&quot;NUMERICAL SUMMARY \342\200\224 TauTimp Redshift (May 2026)&quot;);
</Font>print(&quot;=============================================================&quot;);
print(sprintf(&quot;Rs             = %.6f  Gly&quot;, Rs_Gly));
print(sprintf(&quot;2Rs            = %.6f  Gly  (onduscular boundary)&quot;, 2*Rs_Gly));
print(sprintf(&quot;r_min (flux)   = %.3f    Gly  (inner muon boundary)&quot;, r_min_flux));
print(sprintf(&quot;r_min (cosm.)  = %.3f    Gly  (first star epoch)&quot;, r_min_cosm));
print(sprintf(&quot;G (SI)         = %.5e  m&quot;, G_val));
print(sprintf(&quot;C              = %.5f   m^-2&quot;, C_val));
print(sprintf(&quot;R_H            = %.5f  Gly  (Hubble horizon)&quot;, RH_Gly));
print(sprintf(&quot;H0 (derived)   = %.4f   km/s/Mpc&quot;, evalf(H0_derived_kms, 5)));
print(sprintf(&quot;Integral 0.431-&gt;17.727 = %.2f Gly  (target: 93)&quot;, evalf(cosm_integral, 5)));
print(&quot;=============================================================&quot;);

