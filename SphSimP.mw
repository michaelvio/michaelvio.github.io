# ============================================================
# H = sum_l f_l(r,t) * P_l(cos(theta))
# Use l=0,1,2 with equal amplitude weights D_l = 1

H_field := proc(r_val, theta_val, t_val, V_val)
    local H_sum, l, P_l, f_l_rt;
    H_sum := 0;
    for l from 0 to 2 do
        # Use Airy n=1 mode for each l with weight 1
        f_l_rt := g_A(r_val, 1) * cos(k_A(1) * V_val * t_val);
        # Legendre polynomial P_l(cos(theta))
        P_l := LegendreP(l, cos(theta_val));
        H_sum := H_sum + f_l_rt * P_l;
    end do;
    evalf(H_sum);
end proc:

# Plot H(r,theta,0) as surface in (r, theta)
Nr_H := 50: Nth := 50:
r_H := [seq(0.01*R + (R2-0.01*R)*(i-1)/(Nr_H-1), i=1..Nr_H)]:
