# Case A, d'Alembert, V=c
f_dA := proc(r_val, t_val, n_mode, V_val)
    local omega_n;
    omega_n := n_mode * Pi * V_val / R2;
    sin(n_mode * Pi * (r_val - R2) / R2) * cos(omega_n * t_val);
end proc:

# Case B, d'Alembert, V=c
f_dB := proc(r_val, t_val, n_mode, V_val)
    local omega_n;
    omega_n := n_mode * Pi * V_val / R;
    sin(n_mode * Pi * (r_val - R) / R) * cos(omega_n * t_val);
end proc:

