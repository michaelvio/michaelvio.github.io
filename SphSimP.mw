<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
<Font encoding="UTF-8"># TauTimp \342\200\224 Spherical Symmetry: Variable-Coefficient Wave Equation
</Font># Generalized Framework: Airy + d'Alembert Solutions
# Author: Viorel Popescu
# Maple Transcript v1.0
# ============================================================

restart;
with(plots):
with(plottools):
Digits := 15:

# ============================================================
# SECTION 1: PHYSICAL PARAMETERS
# ============================================================

R  := 4.235518529e22:           # [m]  TauTimp boundary radius
R2 := 2*R:                 # [m]  boundary for Case A
c  := 3.0e8:               # [m/s] speed of light
V1 := c:                   # Case 1: V = c
V2 := 1.0e9 * c:           # Case 2: V = 10^9 * c (onduscular)
V3 := 346.0:               # Case 3: V = 346 m/s (acoustic/phonon)

<Font encoding="UTF-8">printf(&quot;R  = %.6e m\134n&quot;, R):
printf(&quot;2R = %.6e m\134n&quot;, R2):
printf(&quot;V1 (light)      = %.4e m/s\134n&quot;, V1):
printf(&quot;V2 (onduscular) = %.4e m/s\134n&quot;, V2):
printf(&quot;V3 (acoustic)   = %.4e m/s\134n&quot;, V3):
</Font>
# ============================================================
# SECTION 2: AIRY FUNCTION ZEROS
# ============================================================
# Ai(-x) = 0  at x = a_n
# Asymptotic: a_n ~ [3*Pi/8*(4n-1)]^(2/3)

N_modes := 5:

# Compute zeros of Ai(-x) = 0, i.e. Ai(x)=0 shifted
# We use fsolve with asymptotic initial guesses
airy_zero := proc(n::posint) local guess;
    guess := evalf((3*Pi/8*(4*n-1))^(2/3));
    fsolve(AiryAi(-x), x, x = guess - 0.3 .. guess + 0.3);
end proc:

a := Vector(N_modes):
for n from 1 to N_modes do
    a[n] := airy_zero(n);
<Font encoding="UTF-8">    printf(&quot;a[%d] = %.8f\134n&quot;, n, a[n]);
</Font>end do:

# ============================================================
# SECTION 3: EIGENVALUE QUANTIZATION
# ============================================================

<Font encoding="UTF-8"># Wave numbers \342\200\224 Case A: boundary at 2R
</Font>k_A := proc(n) (2 * a[n]^(3/2)) / (3 * R2^(3/2)) * sqrt(R) end proc:

<Font encoding="UTF-8"># Wave numbers \342\200\224 Case B: boundary at R
</Font>k_B := proc(n) (2 * a[n]^(3/2)) / (3 * R^(3/2)) * sqrt(R) end proc:

<Font encoding="UTF-8">printf(&quot;\134n--- Case A: boundary at 2R ---\134n&quot;):
</Font>for n from 1 to N_modes do
<Font encoding="UTF-8">    printf(&quot;k_A[%d] = %.6e m^-1\134n&quot;, n, evalf(k_A(n)));
</Font>end do:

<Font encoding="UTF-8">printf(&quot;\134n--- Case B: boundary at R ---\134n&quot;):
</Font>for n from 1 to N_modes do
<Font encoding="UTF-8">    printf(&quot;k_B[%d] = %.6e m^-1\134n&quot;, n, evalf(k_B(n)));
</Font>end do:

# Frequencies omega_n = k_n * V for all variants
<Font encoding="UTF-8">printf(&quot;\134n--- Frequencies omega = k*V ---\134n&quot;):
printf(&quot;%-6s %-22s %-22s %-22s %-22s %-22s %-22s\134n&quot;,
</Font>    &quot;Mode&quot;,
    &quot;A,V=c&quot;, &quot;A,V=10^9c&quot;, &quot;A,V=346&quot;,
    &quot;B,V=c&quot;, &quot;B,V=10^9c&quot;, &quot;B,V=346&quot;):

for n from 1 to N_modes do
<Font encoding="UTF-8">    printf(&quot;n=%d    %.4e    %.4e    %.4e    %.4e    %.4e    %.4e\134n&quot;, n,
</Font>        evalf(k_A(n)*V1), evalf(k_A(n)*V2), evalf(k_A(n)*V3),
        evalf(k_B(n)*V1), evalf(k_B(n)*V2), evalf(k_B(n)*V3));
end do:

# ============================================================
# SECTION 4: RADIAL AIRY EIGENFUNCTION
# ============================================================

# Dimensionless Airy variable
zeta_A := proc(r_val, n) local kn;
    kn := k_A(n);
    evalf((3*kn/2)^(2/3) * r_val / R^(1/3));
end proc:

# Radial eigenfunction (normalized)
g_A := proc(r_val, n)
    evalf(AiryAi(-zeta_A(r_val, n)) / sqrt(r_val));
end proc:

# ============================================================
<Font encoding="UTF-8"># SECTION 5: PLOTS \342\200\224 RADIAL EIGENFUNCTIONS
</Font># ============================================================

Nr := 300:
r_min := 0.01 * R:
r_max := R2:
r_vals := [seq(r_min + (r_max - r_min)*(i-1)/(Nr-1), i = 1..Nr)]:

# Build data for first 3 modes
colors_modes := [red, blue, green]:
curve_list := []:
for n from 1 to 3 do
    data_n := [seq([r_vals[i]/R, g_A(r_vals[i], n)], i = 1..Nr)]:
    curve_list := [op(curve_list), listplot(data_n, color = colors_modes[n],
        legend = cat(&quot;Mode n=&quot;, n), linestyle = solid)]:
end do:

p_radial := display(curve_list,
    title = &quot;TauTimp: Radial Airy Eigenfunctions g_A(r,n) vs r/R&quot;,
    labels = [&quot;r/R&quot;, &quot;g(r,n) [a.u.]&quot;],
    labeldirections = [horizontal, vertical],
    axes = boxed,
    gridlines = true,
    size = [800, 400]):

print(p_radial):

# ============================================================
# SECTION 6: TIME EVOLUTION f(r,t) = g(r)*u(t)
