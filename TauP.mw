<Font encoding="UTF-8">printf(&quot;\134n=== Temporal Flux F(r,t) = P(r,t)/(4*Pi*r^2) ===\134n&quot;):
</Font>F_func := proc(rv, tv) option remember;
  local Pval;
  Pval := evalf(A_val * ((rv - r0_val)*(rv - R_val) + eps_val*tv + c_val^2*tv^2));
  return evalf(Pval / (4*Pi*rv^2));
end proc:

