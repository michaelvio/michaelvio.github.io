# ---- Complete P solution ----
P_func := proc(rv, tv) option remember;
  local val;
  val := evalf(A_val * ((rv - r0_val)*(rv - R_val) + eps_val*tv + c_val^2*tv^2));
  return val;
end proc:

# ============================================================
