<Group labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"><Font encoding="UTF-8"># TauTimp \342\200\224 Maple Transcript: Temporal Wave Equation, Solar Temporal Flux, and Dilation
</Font># Author: Viorel-Mihai Popescu | Polytechnic University of Bucharest
# Date: 9 June 2026
# ============================================================

restart:
with(plots):
with(plottools):
with(LinearAlgebra):

# ============================================================
# SECTION 1: FUNDAMENTAL PARAMETERS
# ============================================================
<Font encoding="UTF-8">printf(&quot;=== TauTimp Parameters ===\134n&quot;):
</Font>c_val  := 2.998e8:          # speed of light [m/s]
R_val  := 4.235518529e22:        # TauTimp cosmological radius [m]
r0_val := 11222.3:          # Schwarzschild threshold (3.8 R_s_Sun) [m]
tau_q  := 1.765e-19:        # Earth time quantum [s]
t0_val := 500:              # Sun-&gt;Earth propagation time [s]
t1_val := 700:              # Sun-&gt;Mars propagation time [s]
r_Earth:= 1.49e11:          # Earth-Sun distance [m]
r_GEOp := 1.4942e11:        # GEO+ distance from Sun [m]
r_GEOm := 1.4858e11:        # GEO- distance from Sun [m]
r_GPSp := 1.4926e11:        # GPS+ distance from Sun [m]
r_GPSm := 1.4874e11:        # GPS- distance from Sun [m]
r_Mars := 2.09e11:          # Mars-Sun distance [m]

<Font encoding="UTF-8">printf(&quot;c       = %e m/s\134n&quot;, evalf(c_val)):
printf(&quot;R       = %e m\134n&quot;,   evalf(R_val)):
printf(&quot;r0      = %e m\134n&quot;,   evalf(r0_val)):
printf(&quot;tau_q   = %e s\134n&quot;,   evalf(tau_q)):
</Font>
# ============================================================
<Font encoding="UTF-8"># SECTION 2: H-FIELD \342\200\224 VARIABLE-COEFFICIENT WAVE EQUATION
</Font># ============================================================
# PDE: (R/r) Delta H = (1/c^2) d^2H/dt^2
# Under spherical symmetry, separation H(r,t)=g(r)*u(t)
# Temporal part: u(t) = exp(+-i*omega*t)
# Radial part (substituting g=phi/r, xi=(omega^2*r/(R*c^2))^(1/3)):
#   d^2phi/d xi^2 = xi * phi  -&gt; Airy equation
# Solution (Bi excluded, diverges at infinity):
#   g(r) = C/r * Ai[(omega^2*r/(R*c^2))^(1/3)]
# Eigenvalue quantization from g(R)=0:
#   Ai(xi_R) = 0, xi_R = a_n  (Airy zeros)
# For TauTimp quantum number l=21: a_21 ~ -17.03

<Font encoding="UTF-8">printf(&quot;\134n=== Airy Eigenvalue Quantization (l=21 mode) ===\134n&quot;):
</Font>a21   := -17.03:   # 21st Airy zero (absolute)
omega21 := evalf(c_val * abs(a21)^(3/2) / R_val):
<Font encoding="UTF-8">printf(&quot;Airy zero a_21   = %f\134n&quot;,   evalf(a21)):
printf(&quot;omega_21         = %e rad/s\134n&quot;, evalf(omega21)):
</Font>
# Full H field (principal mode, m=0):
# H(r,theta,t) = (C/r)*AiryAi[(omega21^2*r/(R_val*c_val^2))^(1/3)]
#                * LegendreP(21,cos(theta)) * cos(omega21*t)
# Define the Airy argument as function of r:
xi_func := proc(rv) option remember;
  local arg_val;
  arg_val := evalf((omega21^2 * rv / (R_val * c_val^2))^(1/3));
  return arg_val;
end proc:

<Font encoding="UTF-8">printf(&quot;\134nAiry argument at r_Earth: xi = %e\134n&quot;, evalf(xi_func(r_Earth))):
</Font>
# ============================================================
<Font encoding="UTF-8"># SECTION 3: TEMPORAL PROBABILITY P(r,t) \342\200\224 d'ALEMBERT PDE
</Font># ============================================================
<Font encoding="UTF-8">printf(&quot;\134n=== TauTimp Polynomial Ansatz ===\134n&quot;):
</Font># PDE: d^2P/dt^2 - c^2 * d^2P/dr^2 = 0
# Ansatz: P(r,t) = A*[(r-r0)*(r-R) + eps*t + c^2*t^2]
<Font encoding="UTF-8"># Verification: d^2P/dt^2 = 2*A*c^2, d^2P/dr^2 = 2*A -&gt; 2Ac^2 - c^2*2A = 0 \342\234\223
</Font>
# ---- Coefficient A from GEO calibration ----
# Constraint 1 (time quantum): A*eps = tau_q * c^2
# Constraint 2 (GEO+ calibration): Delta_F_GEO = +0.22e-6 hr^-1

# Convert calibration to per-second
DeltaF_GEO_per_s := 0.22e-6 / 3600:  # [s^-1]

Q_func := proc(rv) option remember;
  (rv - r0_val) * (rv - R_val);
end proc:

# From calibration (solving numerically):
A_val   := 1.0312e-17:   # [m^-2]
eps_val := evalf(tau_q * c_val^2 / A_val):

<Font encoding="UTF-8">printf(&quot;A       = %e m^-2\134n&quot;,   evalf(A_val)):
printf(&quot;eps     = %e m^2/s\134n&quot;,  evalf(eps_val)):
printf(&quot;A*eps   = %e m^2/s (should = %e)\134n&quot;,
</Font>        evalf(A_val*eps_val), evalf(tau_q*c_val^2)):

# ---- Polynomial coefficients ----
<Font encoding="UTF-8">printf(&quot;\134n--- Polynomial Coefficients of P(r,t) ---\134n&quot;):
</Font>C_r2 := evalf(A_val):
C_r1 := evalf(-A_val*(r0_val + R_val)):
C_r0 := evalf(A_val*r0_val*R_val):
C_t1 := evalf(A_val*eps_val):
C_t2 := evalf(A_val*c_val^2):
<Font encoding="UTF-8">printf(&quot;C(r^2) = A            = %e m^-2\134n&quot;,   C_r2):
